# Sao chép thành .env khi chạy local (không commit file .env thật).
# Trên Hostinger, đặt các biến này trong hPanel → Web App → Environment variables.

# Cổng lắng nghe — Hostinger tự cấp qua PORT, không cần đặt tay trên đó.
# Chạy local mặc định là 3000.
PORT=3000

# Môi trường: development (local) hoặc production (Hostinger).
NODE_ENV=development

# Thư mục chứa file SQLite (app.db). Mặc định: ./data (đã gitignore).
# Trên Hostinger nên để NGOÀI thư mục repo để dữ liệu an toàn tuyệt đối khi
# deploy lại, ví dụ: DATA_DIR=/home/u215032752/fbads-data
# (xem đúng đường dẫn home trong hPanel → File Manager).
# DATA_DIR=

# Thời gian sống của phiên đăng nhập (ngày). Mặc định 30.
# SESSION_TTL_DAYS=30
